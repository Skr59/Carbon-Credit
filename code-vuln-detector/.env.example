# Copy to `.env` and adjust as needed.

# Base encoder (microsoft/codebert-base default; try microsoft/graphcodebert-base)
VULN_MODEL_NAME=microsoft/codebert-base

# Where a fine-tuned checkpoint is written / read.
VULN_MODEL_PATH=artifacts/codebert-vuln

# API bind address.
VULN_API_HOST=0.0.0.0
VULN_API_PORT=8000

# Enable mixed precision training (needs a CUDA GPU).
VULN_FP16=0
